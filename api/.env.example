# ZenithPay API — Environment Variables
# Base mainnet configuration

# Base RPC
BASE_RPC_URL=https://mainnet.base.org

# x402 facilitator (optional — the @x402/fetch SDK can auto-discover)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Privy server wallet integration
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_AUTHORIZATION_PRIVATE_KEY=wallet-auth:your_key

# SpendPolicy.sol on Base mainnet
SPEND_POLICY_ADDRESS=0xbc62b94c3d427ac8538cd158cecb8e59556c48f0

# Database (Supabase)
DATABASE_URL=postgresql://...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Auth — at least 32 chars (e.g. openssl rand -hex 32)
ZENITHPAY_API_KEY_SECRET=your_64_hex_char_secret_here_minimum_32
